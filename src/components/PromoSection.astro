---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section class="bg-[var(--color-surface-container)] py-12 md:py-16">
  <div class="editorial-shell grid items-center gap-8 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <p class="rounded-r-2xl border-l-4 border-[var(--color-secondary)] bg-white/60 p-6 font-headline text-2xl leading-snug font-bold text-[var(--color-on-surface)] md:text-3xl">
        {text}
      </p>
    </div>
    <div class="order-1 overflow-hidden rounded-3xl lg:order-2">
      <img src="/images/banner-cesantia.jpg" alt="Banner de salud" class="h-full w-full object-cover" />
    </div>
  </div>
</section>
