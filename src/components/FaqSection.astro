---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  faqs: FaqItem[];
}

const { title, faqs } = Astro.props;
---

<section id="faq" class="section-spacing bg-white">
  <div class="editorial-shell mx-auto max-w-4xl">
    <h2 class="text-center font-headline text-3xl font-extrabold tracking-tight md:text-5xl">{title}</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((faq) => (
        <details class="rounded-xl bg-[var(--color-surface-low)] p-5">
          <summary class="cursor-pointer font-semibold">{faq.question}</summary>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-on-surface-variant)]">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
